{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cloud-task-manager-frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "buildCommand": "npm install && npm run build"
    },
    "cloud-task-manager-backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "cloud-task-manager-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "cloud-task-manager-frontend"
      }
    }
  ]
}
